---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookiesMessage from '../components/CockiesMessage.vue';
import WhatsappButton from '../components/WhatsappButton.vue';
import type { Locale } from '../i18n/config';

interface Props {
	lang: string;
	title?: string;
	preloadImage?: string;
}

const { lang = 'es', title = 'Astro Basics', preloadImage } = Astro.props;
const pathname = Astro.url.pathname;
const locale = lang as Locale;
---
<!doctype html>
<html lang={lang} class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light only" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Lora:wght@400;500;600;700&display=swap" rel="stylesheet" />
		{preloadImage && <link rel="preload" as="image" href={preloadImage} />}
		<ClientRouter />
	</head>
	<body>
		<Header lang={locale} pathname={pathname} />
		<main transition:name="main" transition:animate="fade">
			<slot />
		</main>
		<Footer lang={locale} />
		<WhatsappButton client:load />
		<CookiesMessage client:load lang={lang} />
		<script is:inline define:vars={{ lang }}>
			(function() {
				var LOCALES = ['es', 'en', 'cat', 'fr'];

				function getCookie(name) {
					var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
					return match ? decodeURIComponent(match[1]) : null;
				}

				// Only redirect on the home page of a locale (e.g. /es/, /en/)
				var path = window.location.pathname.replace(/\/+$/, '');
				var segments = path.split('/').filter(Boolean);
				if (segments.length > 1) return;

				var saved = getCookie('bp_lang');
				if (saved && LOCALES.indexOf(saved) !== -1 && saved !== lang) {
					window.location.replace('/' + saved + '/');
				}
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		color-scheme: light;
	}
	body {
		background-color: #fafcff;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
	}
</style>
