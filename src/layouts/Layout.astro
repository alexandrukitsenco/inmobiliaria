---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import CookiesMessage from '../components/CockiesMessage.vue';
import WhatsappButton from '../components/WhatsappButton.vue';
import type { Locale } from '../i18n/config';

interface Props {
	lang: string;
	title?: string;
	description?: string;
	image?: string;
	ogType?: 'website' | 'article';
	noindex?: boolean;
	preloadImage?: string;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	lang = 'es',
	title = 'B&P Alojamientos Miami Playa',
	description = 'Alojamientos turísticos en Miami Platja, Costa Dorada. Apartamentos y casas cerca de la playa.',
	image,
	ogType = 'website',
	noindex = false,
	preloadImage,
	jsonLd,
} = Astro.props;
const pathname = Astro.url.pathname;
const locale = lang as Locale;

const jsonLdArray = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang={lang} class="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="color-scheme" content="light only" />
		<link rel="icon" type="image/png" href="/logo.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="apple-touch-icon" href="/logo.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0c4a6e" />
		<title>{title}</title>
		<SEO
			title={title}
			description={description}
			lang={locale}
			image={image}
			type={ogType}
			noindex={noindex}
		/>
		{jsonLdArray.map((ld) => (
			<script type="application/ld+json" set:html={JSON.stringify(ld)} />
		))}
		{preloadImage && <link rel="preload" as="image" href={preloadImage} />}
		<ClientRouter />
	</head>
	<body>
		<Header lang={locale} pathname={pathname} />
		<main transition:name="main" transition:animate="fade">
			<slot />
		</main>
		<Footer lang={locale} />
		<WhatsappButton client:idle />
		<CookiesMessage client:idle lang={lang} />
		<script is:inline define:vars={{ lang }}>
			(function() {
				var LOCALES = ['es', 'en', 'cat', 'fr'];

				function getCookie(name) {
					var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
					return match ? decodeURIComponent(match[1]) : null;
				}

				// Only redirect on the home page of a locale (e.g. /es/, /en/)
				var path = window.location.pathname.replace(/\/+$/, '');
				var segments = path.split('/').filter(Boolean);
				if (segments.length > 1) return;

				var saved = getCookie('bp_lang');
				if (saved && LOCALES.indexOf(saved) !== -1 && saved !== lang) {
					window.location.replace('/' + saved + '/');
				}
			})();
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		color-scheme: light;
	}
	body {
		background-color: #fafcff;
		font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
	}
</style>
