---
import Layout from '../../layouts/Layout.astro';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../../i18n/config';
import { t } from '../../i18n/strings';

export const getStaticPaths = () =>
	LOCALES.map((lang) => ({ params: { lang } }));

const lang = (Astro.params?.lang as Locale) ?? DEFAULT_LOCALE;
---
<Layout lang={lang} title={t(lang, 'cookies', 'pageTitle')} description={t(lang, 'cookies', 'intro')}>
	<div class="container mx-auto px-4 py-12">
		<a
			href={`/${lang}/`}
			class="inline-flex items-center gap-1 text-sm text-ocean-500 hover:text-ocean-700 transition-colors mb-8 no-underline"
		>
			<span>&larr;</span>
			<span>{t(lang, 'nav', 'home')}</span>
		</a>

		<h1 class="text-3xl md:text-4xl font-bold text-ocean-800 mb-4">{t(lang, 'cookies', 'pageTitle')}</h1>
		<p class="text-gray-600 leading-relaxed mb-10 text-lg">{t(lang, 'cookies', 'intro')}</p>

		<section class="mb-8">
			<h2 class="text-xl font-bold text-ocean-700 mb-3 flex items-center gap-2">
				<span class="text-ocean-400">&#x1F4CB;</span>
				{t(lang, 'cookies', 'whatTitle')}
			</h2>
			<p class="text-gray-600 leading-relaxed">{t(lang, 'cookies', 'whatText')}</p>
		</section>

		<section class="mb-8">
			<h2 class="text-xl font-bold text-ocean-700 mb-4 flex items-center gap-2">
				<span class="text-ocean-400">&#x1F4E6;</span>
				{t(lang, 'cookies', 'typesTitle')}
			</h2>

			<div class="space-y-4">
				<div class="rounded-xl border border-ocean-100 bg-white p-5">
					<h3 class="font-semibold text-ocean-800 mb-2 flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-ocean-400"></span>
						{t(lang, 'cookies', 'technicalTitle')}
					</h3>
					<p class="text-gray-600 text-sm leading-relaxed">{t(lang, 'cookies', 'technicalText')}</p>
				</div>

				<div class="rounded-xl border border-ocean-100 bg-white p-5">
					<h3 class="font-semibold text-ocean-800 mb-2 flex items-center gap-2">
						<span class="w-2 h-2 rounded-full bg-ocean-400"></span>
						{t(lang, 'cookies', 'preferencesTitle')}
					</h3>
					<p class="text-gray-600 text-sm leading-relaxed">{t(lang, 'cookies', 'preferencesText')}</p>
				</div>
			</div>
		</section>

		<section class="mb-8">
			<h2 class="text-xl font-bold text-ocean-700 mb-3 flex items-center gap-2">
				<span class="text-ocean-400">&#x2699;</span>
				{t(lang, 'cookies', 'manageTitle')}
			</h2>
			<p class="text-gray-600 leading-relaxed">{t(lang, 'cookies', 'manageText')}</p>
		</section>

		<section class="mb-12">
			<h2 class="text-xl font-bold text-ocean-700 mb-3 flex items-center gap-2">
				<span class="text-ocean-400">&#x2709;</span>
				{t(lang, 'cookies', 'contactTitle')}
			</h2>
			<p class="text-gray-600 leading-relaxed">{t(lang, 'cookies', 'contactText')}</p>
		</section>
	</div>
</Layout>
