---
import Layout from '../../layouts/Layout.astro';
import { DEFAULT_LOCALE, type Locale } from '../../i18n/config';
import { t } from '../../i18n/strings';

export const getStaticPaths = () =>   [
	{ params: { lang: 'es' } },
	{ params: { lang: 'en' } },
	{ params: { lang: 'cat' } },
];

const lang = (Astro.params?.lang as Locale ) ?? DEFAULT_LOCALE;
console.log(Astro);
---
<Layout lang={lang} title={t(lang, 'home', 'title')}>
	<div class="bg-gray-600 text-white p-4">
		{t(lang, 'home', 'greeting')}
	</div>
</Layout>
