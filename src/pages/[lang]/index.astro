---
import { getImage } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../../i18n/config';
import { t } from '../../i18n/strings';
import { apartamentos, contact } from '../../i18n/apartamentos';
import { blueRawImages, paradiseRawImages } from '../../lib/apartment-images';
import heroBeachRaw from '../../assets/cala-las-sirenas-miami-playa-tarragona.webp';

export const getStaticPaths = () =>
	LOCALES.map((lang) => ({ params: { lang } }));

const lang = (Astro.params?.lang as Locale) ?? DEFAULT_LOCALE;
const welcome = apartamentos[lang].welcome;
const blue = apartamentos[lang].blue;
const paradise = apartamentos[lang].paradise;

// Optimize images at build time
const heroBeach = await getImage({ src: heroBeachRaw, format: 'webp', width: 1920 });
const blueThumb = await getImage({ src: blueRawImages[0], format: 'webp', width: 800 });
const paradiseThumb = await getImage({ src: paradiseRawImages[0], format: 'webp', width: 800 });

const apartments = [
	{ id: 'blue', data: blue, image: blueThumb.src },
	{ id: 'paradise', data: paradise, image: paradiseThumb.src },
];

const accommodationTitle = t(lang, 'nav', 'ourAccommodation');
const viewMore = t(lang, 'nav', 'viewMore');

const phoneClean = contact.phone.replace(/\s+/g, '');
const whatsappUrl = `https://wa.me/${phoneClean}`;

const siteUrl = 'https://www.bpmiamiplaya.es';

const localBusinessJsonLd = {
	'@context': 'https://schema.org',
	'@type': 'LodgingBusiness',
	name: 'B&P Alojamientos Miami Playa',
	description: welcome.intro,
	url: siteUrl,
	telephone: contact.phone,
	email: contact.email,
	image: `${siteUrl}/logo.png`,
	address: {
		'@type': 'PostalAddress',
		addressLocality: 'Miami Platja',
		addressRegion: 'Tarragona',
		addressCountry: 'ES',
	},
	geo: {
		'@type': 'GeoCoordinates',
		latitude: 41.0643,
		longitude: 1.0192,
	},
	sameAs: [contact.instagram],
};
---
<Layout
	lang={lang}
	title={welcome.title}
	description={welcome.intro}
	image={heroBeach.src}
	jsonLd={localBusinessJsonLd}
>
	<!-- Hero with beach photo -->
	<div class="relative text-white overflow-hidden">
		<!-- Background image -->
		<img
			src={heroBeach.src}
			alt=""
			class="absolute inset-0 w-full h-full object-cover object-center"
			loading="eager"
			fetchpriority="high"
			decoding="async"
		/>
		<!-- Blue overlay for readability -->
		<div class="absolute inset-0 bg-ocean-900/60 mix-blend-multiply"></div>
		<div class="absolute inset-0 bg-linear-to-b from-ocean-800/40 via-transparent to-ocean-900/70"></div>
		<!-- Wave SVG bottom -->
		<svg class="absolute bottom-0 left-0 w-full z-10" viewBox="0 0 1440 120" preserveAspectRatio="none">
			<path fill="#fafcff" d="M0,96L60,85.3C120,75,240,53,360,53.3C480,53,600,75,720,80C840,85,960,75,1080,64C1200,53,1320,43,1380,37.3L1440,32L1440,120L0,120Z" />
		</svg>
		<div class="container mx-auto px-4 pt-20 pb-40 md:pt-24 md:pb-44 relative z-10 text-center">
			<p class="text-white/70 text-sm uppercase tracking-widest mb-3">B&P Miami Playa</p>
			<h1 class="text-3xl md:text-5xl lg:text-6xl font-extrabold tracking-tight leading-tight max-w-3xl mx-auto drop-shadow-lg">{welcome.title}</h1>
			<p class="mt-4 md:mt-6 text-base md:text-xl text-white/85 max-w-2xl mx-auto leading-relaxed drop-shadow">{welcome.intro}</p>
		</div>
	</div>

	<div class="container mx-auto px-6 relative z-20">
		<!-- Apartment cards -->
		<section class="mb-16">
			<h2 class="text-2xl md:text-3xl font-bold text-ocean-800 text-center mb-10">{accommodationTitle}</h2>
			<div class="grid gap-8 md:grid-cols-2 px-1">
				{apartments.map((apt) => (
					<a
						href={`/${lang}/apartamento/${apt.id}`}
						class="group block rounded-2xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 bg-white no-underline"
					>
						<div class="aspect-16/10 overflow-hidden bg-ocean-50">
							<img
								src={apt.image}
								alt={apt.data.name}
								loading="lazy"
								decoding="async"
								class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
							/>
						</div>
						<div class="p-6">
							<p class="text-xs uppercase tracking-wider text-ocean-400 font-semibold mb-1">{apt.data.subtitle}</p>
							<h3 class="text-xl font-bold text-gray-900 group-hover:text-ocean-600 transition-colors">{apt.data.name}</h3>
							<p class="mt-2 text-gray-500 text-sm leading-relaxed line-clamp-2">{apt.data.shortDescription}</p>
							<div class="mt-4 flex items-center gap-1 text-ocean-500 text-sm font-semibold">
								<span>{viewMore}</span>
								<span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
							</div>
						</div>
					</a>
				))}
			</div>
		</section>

		<!-- About section -->
		<section class="mb-16 max-w-3xl mx-auto text-center">
			<div class="rounded-2xl bg-linear-to-br from-ocean-50 to-sand-50 p-8 md:p-12 border border-ocean-100">
				<span class="text-4xl mb-4 block">&#x1F30A;</span>
				<p class="text-gray-600 leading-relaxed">{welcome.body}</p>
			</div>
		</section>

		<!-- Contact section -->
		<section id="contacto" class="mb-16 scroll-mt-20">
			<div class="rounded-2xl bg-ocean-900 text-white p-8 md:p-12 relative overflow-hidden">
				<svg class="absolute -right-12 -top-12 w-48 h-48 text-ocean-800/30" viewBox="0 0 100 100" fill="currentColor">
					<circle cx="50" cy="50" r="50" />
				</svg>
				<svg class="absolute -left-8 -bottom-8 w-32 h-32 text-ocean-800/20" viewBox="0 0 100 100" fill="currentColor">
					<circle cx="50" cy="50" r="50" />
				</svg>

				<div class="relative z-10 text-center">
					<h2 class="text-2xl md:text-3xl font-bold mb-2">{t(lang, 'contact', 'title')}</h2>
					<p class="text-ocean-200 mb-8 max-w-lg mx-auto">{t(lang, 'contact', 'subtitle')}</p>

					<div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-8">
						<a href={`tel:${phoneClean}`} class="flex items-center gap-2 text-lg font-semibold text-white no-underline hover:text-ocean-200 transition-colors">
							<i class="pi pi-phone"></i>
							{contact.phone}
						</a>
						<span class="hidden sm:inline text-ocean-600">&middot;</span>
						<a href={`mailto:${contact.email}`} class="flex items-center gap-2 text-lg font-semibold text-white no-underline hover:text-ocean-200 transition-colors">
							<i class="pi pi-envelope"></i>
							{contact.email}
						</a>
					</div>

					<div class="flex flex-col sm:flex-row items-center justify-center gap-3">
						<a
							href={`tel:${phoneClean}`}
							class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-white text-ocean-800 font-semibold text-sm hover:bg-ocean-50 transition-colors no-underline w-full sm:w-auto justify-center"
						>
							<i class="pi pi-phone"></i>
							{t(lang, 'contact', 'callUs')}
						</a>
						<a
							href={`mailto:${contact.email}`}
							class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-ocean-700 text-white font-semibold text-sm hover:bg-ocean-600 transition-colors no-underline border border-ocean-500 w-full sm:w-auto justify-center"
						>
							<i class="pi pi-envelope"></i>
							{t(lang, 'contact', 'emailUs')}
						</a>
						<a
							href={whatsappUrl}
							target="_blank"
							rel="noopener noreferrer"
							class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-[#25D366] text-white font-semibold text-sm hover:bg-[#1ebe5b] transition-colors no-underline w-full sm:w-auto justify-center"
						>
							<i class="pi pi-whatsapp"></i>
							{t(lang, 'contact', 'whatsapp')}
						</a>
					</div>
				</div>
			</div>
		</section>

	</div>
</Layout>
