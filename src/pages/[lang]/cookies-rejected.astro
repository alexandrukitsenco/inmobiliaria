---
import Layout from '../../layouts/Layout.astro';
import AcceptCookiesButton from '../../components/AcceptCookiesButton.vue';
import { DEFAULT_LOCALE, LOCALES, type Locale } from '../../i18n/config';
import { t } from '../../i18n/strings';

export const getStaticPaths = () =>
	LOCALES.map((lang) => ({ params: { lang } }));

const lang = (Astro.params?.lang as Locale) ?? DEFAULT_LOCALE;
---
<Layout lang={lang} title={t(lang, 'cookies', 'rejectedTitle')} description={t(lang, 'cookies', 'rejectedMessage')} noindex>
	<div class="min-h-[60vh] flex items-center justify-center px-4">
		<div class="text-center max-w-md">
			<div class="text-6xl mb-6">&#x1F36A;</div>
			<h1 class="text-2xl md:text-3xl font-bold text-ocean-800 mb-4">{t(lang, 'cookies', 'rejectedTitle')}</h1>
			<p class="text-gray-600 leading-relaxed mb-8">{t(lang, 'cookies', 'rejectedMessage')}</p>
			<AcceptCookiesButton client:idle lang={lang} />
			<div class="mt-6">
				<a
					href={`/${lang}/cookies`}
					class="text-sm text-ocean-500 hover:text-ocean-700 underline transition-colors"
				>{t(lang, 'cookies', 'pageTitle')}</a>
			</div>
		</div>
	</div>
</Layout>
