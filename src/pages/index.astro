---
---
<html>
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content="1;url=/en/" />
    <link rel="canonical" href="/en/" />
    <script is:inline>
      (function() {
        var LOCALES = ['es', 'en', 'cat', 'fr'];
        var FALLBACK = 'en';

        function getCookie(name) {
          var match = document.cookie.match(new RegExp('(?:^|; )' + name + '=([^;]*)'));
          return match ? decodeURIComponent(match[1]) : null;
        }

        // 1. User's previously selected language
        var saved = getCookie('bp_lang');
        if (saved && LOCALES.indexOf(saved) !== -1) {
          window.location.replace('/' + saved + '/');
          return;
        }

        // 2. Browser language
        var langs = navigator.languages || [navigator.language || ''];
        for (var i = 0; i < langs.length; i++) {
          var code = langs[i].toLowerCase().split('-')[0];
          if (code === 'ca') code = 'cat';
          if (LOCALES.indexOf(code) !== -1) {
            window.location.replace('/' + code + '/');
            return;
          }
        }

        // 3. Fallback to English
        window.location.replace('/' + FALLBACK + '/');
      })();
    </script>
  </head>
  <body></body>
</html>
