---
import { LOCALES, type Locale } from '../i18n/config';

interface Props {
	title: string;
	description: string;
	lang: Locale;
	image?: string;
	type?: 'website' | 'article';
	noindex?: boolean;
}

const SITE = 'https://www.bpmiamiplaya.es';

const HREFLANG_MAP: Record<string, string> = {
	es: 'es',
	en: 'en',
	cat: 'ca',
	fr: 'fr',
};

const { title, description, lang, image, type = 'website', noindex = false } = Astro.props;

const canonicalPath = Astro.url.pathname;
const canonicalURL = new URL(canonicalPath, SITE).href;

const ogImage = image
	? new URL(image, SITE).href
	: new URL('/logo.png', SITE).href;

function buildAlternatePath(targetLang: string): string {
	const segments = canonicalPath.split('/').filter(Boolean);
	if (segments.length > 0 && LOCALES.includes(segments[0] as Locale)) {
		segments[0] = targetLang;
	}
	return '/' + segments.join('/') + '/';
}
---

<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalURL} />

<!-- hreflang alternates -->
{LOCALES.map((loc) => (
	<link
		rel="alternate"
		hreflang={HREFLANG_MAP[loc] || loc}
		href={new URL(buildAlternatePath(loc), SITE).href}
	/>
))}
<link rel="alternate" hreflang="x-default" href={new URL(buildAlternatePath('es'), SITE).href} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={HREFLANG_MAP[lang] || lang} />
<meta property="og:site_name" content="B&P Alojamientos Miami Playa" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
