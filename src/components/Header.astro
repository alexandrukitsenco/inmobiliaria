---
import { Image } from 'astro:assets';
import logoPng from '../assets/logo.png';
import LangSelector from './LangSelector.vue';
import MobileMenu from './MobileMenu.vue';
import type { Locale } from '../i18n/config';
import { apartamentos } from '../i18n/apartamentos';
import { t } from '../i18n/strings';

interface Props {
  lang: Locale;
  pathname: string;
}

const { lang, pathname } = Astro.props;

const blue = apartamentos[lang].blue;
const paradise = apartamentos[lang].paradise;

const apartmentLinks = [
  { name: blue.name, href: `/${lang}/apartamento/blue` },
  { name: paradise.name, href: `/${lang}/apartamento/paradise` },
];

const contactLabel = t(lang, 'contact', 'title');

const menuLabels = {
  home: t(lang, 'nav', 'home'),
  apartments: t(lang, 'nav', 'apartments'),
  contact: contactLabel,
  language: t(lang, 'nav', 'language'),
  menu: t(lang, 'nav', 'menu'),
};

/** Check if a link matches the current page */
function isActive(href: string): boolean {
  const clean = pathname.replace(/\/+$/, '');
  const target = href.replace(/\/+$/, '');
  return clean === target;
}

const isHome = isActive(`/${lang}`);
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-sm border-b border-ocean-100">
  <div class="container mx-auto px-4 flex items-center justify-between py-3">
    <!-- Logo (left) -->
    <a href={`/${lang}/`} class:list={[
      "flex items-center gap-2 no-underline transition-colors shrink-0",
      isHome ? "text-ocean-600" : "text-ocean-800 hover:text-ocean-600"
    ]}>
      <Image src={logoPng} alt="B&P Miami Playa" width={72} height={72} class="h-9 w-auto" loading="eager" />
      <span class="font-heading font-bold text-lg tracking-tight">B&P Miami Playa</span>
    </a>

    <!-- Apartments (center) -->
    <nav class="hidden md:flex items-center gap-6 absolute left-1/2 -translate-x-1/2">
      {apartmentLinks.map((apt) => (
        <a
          href={apt.href}
          class:list={[
            "text-sm font-medium no-underline transition-colors relative pb-1",
            isActive(apt.href)
              ? "text-ocean-600 border-b-2 border-ocean-500"
              : "text-gray-600 hover:text-ocean-600"
          ]}
        >
          {apt.name}
        </a>
      ))}
    </nav>

    <!-- Contact + Language (right) -->
    <div class="hidden md:flex items-center gap-4 shrink-0">
      <a
        id="nav-contact"
        href={`/${lang}/#contacto`}
        class="text-sm font-medium no-underline transition-colors relative pb-1 text-gray-600 hover:text-ocean-600"
      >
        {contactLabel}
      </a>
      <span class="w-px h-4 bg-ocean-200"></span>
      <LangSelector client:idle currentLang={lang} pathname={pathname} />
    </div>

    <!-- Mobile menu (hidden on desktop) -->
    <MobileMenu
      client:idle
      lang={lang}
      pathname={pathname}
      labels={menuLabels}
      apartmentLinks={apartmentLinks}
    />
  </div>
</header>

<script>
function setupContactObserver() {
  const link = document.getElementById('nav-contact');
  const section = document.getElementById('contacto');
  if (!link || !section) return;

  const observer = new IntersectionObserver(
    ([entry]) => {
      if (entry.isIntersecting) {
        link.classList.add('text-ocean-600', 'border-b-2', 'border-ocean-500');
        link.classList.remove('text-gray-600');
      } else {
        link.classList.remove('text-ocean-600', 'border-b-2', 'border-ocean-500');
        link.classList.add('text-gray-600');
      }
    },
    { threshold: 0.3 }
  );
  observer.observe(section);
}

setupContactObserver();
document.addEventListener('astro:after-swap', setupContactObserver);
</script>
